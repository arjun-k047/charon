# Copy to .env and fill in real values. .env is gitignored - never commit it.

# LLM provider: any OpenAI-compatible endpoint. Developed and tested with
# NVIDIA NIM (free tier). Set all three LLM_* variables. NVIDIA_API_KEY,
# NVIDIA_BASE_URL and NVIDIA_MODEL are used only when no LLM_* variable is
# set; once any LLM_* variable is set they are ignored, so a leftover
# NVIDIA_API_KEY is never sent to the provider configured here.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model availability on build.nvidia.com changes; check it before use.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Another OpenAI-compatible provider replaces the block above. Untested
# placeholder values:
# LLM_API_KEY=<provider key>
# LLM_BASE_URL=<provider OpenAI-compatible base URL>
# LLM_MODEL=<provider model id>

# PostgreSQL
DATABASE_URL=postgresql://charon:charon@localhost:5432/charon
